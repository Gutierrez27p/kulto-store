# Copy this file to ".env" and fill in your own Supabase project values.
# Find them in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional — powers the "Rellenar con IA" button in the admin panel.
# No VITE_ prefix on purpose: this one must stay server-side only.
# See the README (Paso 4.5) for how to get a key.
ANTHROPIC_API_KEY=

# Optional pero recomendado — manda el mail de confirmación de cuenta y el
# mail de "gracias por tu compra". Sin esto, la web sigue funcionando igual,
# simplemente no se mandan esos mails. Conseguí una clave gratis en
# https://resend.com (Paso 4.6 del README).
RESEND_API_KEY=
# Opcional: la dirección "de" de los mails. Sin verificar tu propio dominio
# en Resend, dejá esto vacío (se usa una dirección de prueba de Resend).
RESEND_FROM_EMAIL=
